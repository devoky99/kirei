    "Kept as the original": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird als Original behalten"
          }
        }
      }
    },
    "Kirei looks for duplicates, similar shots and blurry photos. Everything stays on your device, and nothing is deleted without you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirei sucht Duplikate, ähnliche Aufnahmen und unscharfe Fotos. Alles bleibt auf deinem Gerät, und nichts wird ohne dich gelöscht."
          }
        }
      }
    },
    "Large videos": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Große Videos"
          }
        }
      }
    },
    "Less sharp than the photo you keep": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unschärfer als das behaltene Foto"
