{
  "sourceLanguage": "en",
  "strings": {
    "%lld new since last time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld neu seit dem letzten Mal"
          }
        }
      }
    },
